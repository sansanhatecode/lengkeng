{
  "name": "lengkeng",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @lengkeng/api prisma:migrate",
    "db:seed": "pnpm --filter @lengkeng/api prisma:seed",
    "e2e": "pnpm --filter @lengkeng/e2e test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "prettier": "^3.5.0"
  },
  "engines": { "node": ">=22" }
}
